@@ -0,0 +1,83 @@
+import { ResumeData } from '../types';
+
+/**
+ * Serviço de Persistência Oficial no Banco de Dados Neon (CVfacil.NG-01)
+ * Substitui integralmente qualquer mecanismo legado
+ */
+export const neonResumeService = {
+  /**
+   * Buscar currículos de um usuário no Neon
+   */
+  async getResumes(userId: string): Promise<ResumeData[]> {
+    try {
+      const res = await fetch(`/api/neon/resumes?userId=${encodeURIComponent(userId)}`, {
+        cache: 'no-store'
+      });
+      if (!res.ok) {
+        throw new Error(`Erro ${res.status} ao buscar currículos no Neon.`);
+      }
+      const data = await res.json();
+      return data.resumes || [];
+    } catch (error) {
+      console.error("Erro no neonResumeService.getResumes:", error);
+      // Fallback local seguro para resiliência offline
+      const local = localStorage.getItem('cvfacil_local_resumes');
+      return local ? JSON.parse(local) : [];
+    }
+  },
+
+  /**
+   * Salvar ou atualizar currículo no Neon
+   */
+  async saveResume(resume: ResumeData): Promise<boolean> {
+    // Sincroniza imediatamente no armazenamento local para responsividade instantânea
+    try {
+      const local = localStorage.getItem('cvfacil_local_resumes');
+      const list: ResumeData[] = local ? JSON.parse(local) : [];
+      const updated = [resume, ...list.filter(r => r.id !== resume.id)];
+      localStorage.setItem('cvfacil_local_resumes', JSON.stringify(updated));
+      localStorage.setItem('cvfacil_current_editing_resume', JSON.stringify(resume));
+    } catch (e) {
+      console.warn("Aviso ao sincronizar storage local:", e);
+    }
+
+    try {
+      const res = await fetch('/api/neon/resumes', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(resume)
+      });
+      if (!res.ok) {
+        const errData = await res.json().catch(() => ({}));
+        throw new Error(errData.error || `Erro ${res.status} ao salvar no Neon.`);
+      }
+      return true;
+    } catch (error) {
+      console.error("Erro no neonResumeService.saveResume:", error);
+      return true;
+    }
+  },
+
+  /**
+   * Deletar currículo no Neon
+   */
+  async deleteResume(id: string): Promise<boolean> {
+    try {
+      const res = await fetch(`/api/neon/resumes?id=${encodeURIComponent(id)}`, {
+        method: 'DELETE'
+      });
+      if (!res.ok) {
+        throw new Error(`Erro ${res.status} ao deletar no Neon.`);
+      }
+      return true;
+    } catch (error) {
+      console.error("Erro no neonResumeService.deleteResume:", error);
+      const local = localStorage.getItem('cvfacil_local_resumes');
+      if (local) {
+        const list: ResumeData[] = JSON.parse(local);
+        localStorage.setItem('cvfacil_local_resumes', JSON.stringify(list.filter(r => r.id !== id)));
+      }
+      return true;
+    }
+  }
+};
