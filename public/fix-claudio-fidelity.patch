+name: CI/CD Pipeline - Deploy para VPS Hostinger
+
+on:
+  push:
+    branches:
+      - main
+      - master
+
+jobs:
+  build-and-test:
+    name: Build & Validação
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout do código
+        uses: actions/checkout@v4
+
+      - name: Configurar Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+
+      - name: Instalar Dependências
+        run: npm ci || npm install
+
+      - name: Executar Testes Unitários e Integrados
+        run: npm test
+
+      - name: Compilar Projeto (Next.js Build)
+        env:
+          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
+          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
+          NEXT_PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY }}
+        run: npm run build
+
+  deploy-vps:
+    name: Deploy na VPS Hostinger
+    needs: build-and-test
+    runs-on: ubuntu-latest
+    if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master'
+
+    steps:
+      - name: Executar Deploy via SSH na VPS
+        uses: appleboy/ssh-action@v1.0.3
+        with:
+          host: ${{ secrets.VPS_HOST || '69.62.87.38' }}
+          username: ${{ secrets.VPS_USER || 'root' }}
+          key: ${{ secrets.VPS_SSH_KEY }}
+          password: ${{ secrets.VPS_PASSWORD }}
+          port: ${{ secrets.VPS_PORT || 22 }}
+          script_stop: true
+          script: |
+            set -e
+            echo "🚀 [DevOps] Iniciando deploy automático na VPS Hostinger..."
+            APP_DIR="${{ secrets.VPS_APP_DIR || '/var/www/cvfacil-ng' }}"
+            
+            # 1. Garante que o diretório da aplicação existe e está clonado
+            if [ ! -d "$APP_DIR" ]; then
+              echo "📁 Diretório $APP_DIR não encontrado. Clonando repositório..."
+              mkdir -p "$APP_DIR"
+              git clone https://github.com/claudiofxbr/CVFacil.NG-01.git "$APP_DIR"
+            fi
+
+            cd "$APP_DIR"
+
+            # 2. Atualiza o código fonte com o commit recém-enviado
+            echo "📥 Sincronizando com a branch main do GitHub..."
+            git fetch origin main
+            git reset --hard origin/main
+
+            # 3. Instalação de dependências e Build de Produção
+            echo "📦 Instalando dependências e compilando..."
+            npm install --production=false --prefer-offline --no-audit
+            npm run build
+
+            # 4. Configuração isolada do Nginx (NÃO TOCA NO PortalCursos.NG)
+            if [ ! -f "/etc/nginx/sites-available/cvfacil-ng" ]; then
+              echo "🌐 Criando configuração isolada do Nginx..."
+              cat << 'NGINX_EOF' > /etc/nginx/sites-available/cvfacil-ng
+server {
+    listen 80;
+    server_name cvfacil.xavierbr-vps.tech;
+    return 301 https://$host$request_uri;
+}
+
+server {
+    listen 443 ssl http2;
+    server_name cvfacil.xavierbr-vps.tech;
+
+    ssl_certificate /etc/letsencrypt/live/cvfacil.xavierbr-vps.tech/fullchain.pem;
+    ssl_certificate_key /etc/letsencrypt/live/cvfacil.xavierbr-vps.tech/privkey.pem;
+    include /etc/letsencrypt/options-ssl-nginx.conf;
+    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
+
+    client_max_body_size 30M;
+
+    location / {
+        proxy_pass http://127.0.0.1:3003;
+        proxy_http_version 1.1;
+        proxy_set_header Upgrade $http_upgrade;
+        proxy_set_header Connection 'upgrade';
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto https;
+        proxy_cache_bypass $http_upgrade;
+    }
+}
+NGINX_EOF
+              ln -sf /etc/nginx/sites-available/cvfacil-ng /etc/nginx/sites-enabled/cvfacil-ng
+              nginx -t && systemctl reload nginx || true
+            fi
+
+            # 5. Reinicialização segura no PM2
+            echo "🔄 Reiniciando serviço no PM2 com isolamento de porta 3003..."
+            if pm2 list | grep -q "cvfacil-ng"; then
+              pm2 reload cvfacil-ng --update-env
+            else
+              pm2 start npm --name "cvfacil-ng" -- run start -- -p 3003
+              pm2 save
+            fi
+
+            echo "✅ Deploy concluído com sucesso e aplicação online!"
