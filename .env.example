API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# Servidor: lista (separada por vírgula) de e-mails com papel de administrador. Sem ela, ninguém é admin.
ADMIN_EMAILS=

# PagBank (Checkout hospedado). Sem valores aqui; em produção vêm dos GitHub Secrets.
# PAGBANK_ENV: "sandbox" (padrão) ou "production" (exatamente). Token de produção não funciona no sandbox e vice-versa.
PAGBANK_TOKEN=
PAGBANK_ENV=sandbox
# URL pública https do app (redirect e webhook). Padrão: https://cvfacil.xavierbr-vps.tech
APP_BASE_URL=
